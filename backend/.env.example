# Database
DATABASE_URL=postgresql://studenthelp:studenthelp@localhost:5432/studenthelp
# false because Alembic migrations exist now (see migrations/versions/) -
# run `alembic upgrade head` instead. Only set true for quick throwaway
# local experiments with no migration history to preserve.
AUTO_CREATE_TABLES=false

# Auth
SECRET_KEY=change-this-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Job listings (Adzuna free tier - https://developer.adzuna.com)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in

# File storage - S3-compatible (AWS S3 or Cloudflare R2)
# For Cloudflare R2 (recommended - generous free tier, no egress fees):
#   S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# For AWS S3, leave S3_ENDPOINT_URL empty and set a real region.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=studenthelp-resumes
S3_REGION=auto
S3_PUBLIC_URL_BASE=

# Email (for password reset) - leave SMTP_HOST empty to skip real sending;
# /auth/forgot-password will return the reset token directly for dev testing.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an "app
# password" (not your real password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

FRONTEND_URL=http://localhost:3000

# App
ENV=development
CORS_ORIGINS=http://localhost:3000

# Error monitoring (optional). Leave empty to run without Sentry.
SENTRY_DSN=
